#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sector Rotation Screener
========================
Detects capital rotation by calculating Relative Strength (RS) of various 
sectors against a benchmark (e.g., SPY or TSX).

Features:
- RS Momentum (Slope) analysis on log price for geometric drift.
- Inflow/Outflow detection.
- Pairwise rotation suggestions.
- Simplified Relative Rotation Graph (RRG) plotting.

Dependencies:
    pip install yfinance pandas numpy matplotlib
"""

import argparse
import json
import numpy as np
import pandas as pd
import yfinance as yf
import matplotlib.pyplot as plt
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

# -----------------------------------------------------------------------------
# Configuration & Defaults
# -----------------------------------------------------------------------------

DEFAULT_SECTORS = {
    "XLY": "Consumer Discretionary",
    "XLP": "Consumer Staples",
    "XLE": "Energy",
    "XLF": "Financials",
    "XLV": "Health Care",
    "XLK": "Technology",
    "XLI": "Industrials",
    "XLB": "Materials",
    "XLRE": "Real Estate",
    "XLC": "Communication Services",
    "XLU": "Utilities",
}
DEFAULT_BENCH = "SPY"

@dataclass
class SectorMetrics:
    symbol: str
    sector: str
    close: float
    rs_level: float
    rs_slope: float
    rs_slope_ann_pct: float
    ret_1w: float
    ret_1m: float
    ret_3m: float
    vol_z60: float
    sma50_above_sma200: Optional[bool] = None

# -----------------------------------------------------------------------------
# Mathematical Utilities
# -----------------------------------------------------------------------------

def pct_change(series: pd.Series, window: int) -> float:
    """Calculates percentage change over a specific window."""
    if len(series) < window + 1:
        return np.nan
    return float(series.iloc[-1] / series.iloc[-window - 1] - 1.0)

def linreg_slope(y: np.ndarray) -> float:
    """Calculates the slope of a simple OLS fit."""
    n = len(y)
    if n < 5 or np.any(~np.isfinite(y)):
        return np.nan
    t = np.arange(n, dtype=float)
    b = np.polyfit(t, y, 1)[0]
    return float(b)

def zscore_last(values: pd.Series, window: int = 60) -> float:
    """Calculates the Z-Score of the last value relative to the window."""
    v = values.tail(window)
    if v.size < 10:
        return np.nan
    return float((v.iloc[-1] - v.mean()) / (v.std(ddof=0) + 1e-12))

def annualize_daily(slope_per_bar: float, bars_per_year: int = 252) -> float:
    """Converts a daily log-slope into an approximate annualized % drift."""
    if not np.isfinite(slope_per_bar):
        return np.nan
    return float(np.expm1(slope_per_bar * bars_per_year))

# -----------------------------------------------------------------------------
# Data Ingestion
# -----------------------------------------------------------------------------

def load_custom_mapping(path: str) -> Dict[str, str]:
    """Loads symbol-to-sector mapping from a CSV."""
    df = pd.read_csv(path)
    if "symbol" not in df.columns or "sector" not in df.columns:
        if df.shape[1] >= 2:
            df.columns = ["symbol", "sector"] + list(df.columns[2:])
        else:
            raise ValueError("CSV must have columns: symbol, sector")
    
    mapping = {
        str(row["symbol"]).strip().upper(): str(row["sector"]).strip()
        for _, row in df.iterrows()
        if str(row["symbol"]).strip() and str(row["sector"]).strip()
    }
    return mapping

def download_data(tickers: List[str], period: str = "2y") -> Dict[str, pd.DataFrame]:
    """Downloads price data and splits it into a per-ticker dictionary."""
    print(f"[*] Downloading data for {len(tickers)} tickers...")
    df = yf.download(tickers, period=period, interval="1d", auto_adjust=False, progress=False)
    
    out = {}
    for t in tickers:
        try:
            if len(tickers) > 1:
                sub = df.xs(t, axis=1, level=1).dropna().reset_index()
            else:
                sub = df.dropna().reset_index()
            
            sub.columns = [c.lower().replace(" ", "_") for c in sub.columns]
            out[t] = sub
        except KeyError:
            print(f"[!] Warning: No data found for {t}")
    return out

# -----------------------------------------------------------------------------
# Core Screening Logic
# -----------------------------------------------------------------------------

def compute_sector_metrics(
    panels: Dict[str, pd.DataFrame],
    mapping: Dict[str, str],
    benchmark: str,
    slope_window: int,
    ret_windows: Tuple[int, int, int] = (5, 21, 63)
) -> List[SectorMetrics]:
    """Processes raw prices into sector rotation metrics."""
    if benchmark not in panels:
        raise ValueError(f"Benchmark {benchmark} data missing.")

    bench = panels[benchmark].copy().set_index("date")
    metrics_list = []

    for sym, name in mapping.items():
        if sym == benchmark or sym not in panels:
            continue
            
        df = panels[sym].copy().set_index("date")
        aligned = df.join(bench[["adj_close"]].rename(columns={"adj_close": "bench_adj"}), how="inner")

        if aligned.shape[0] < max(80, slope_window + 10):
            continue

        # Relative Strength Logic
        aligned["rs"] = aligned["adj_close"] / aligned["bench_adj"]
        aligned["log_rs"] = np.log(aligned["rs"])
        
        rs_slope = linreg_slope(aligned["log_rs"].tail(slope_window).values)
        ann_pct = annualize_daily(rs_slope)

        # Technical Indicators
        w1, w2, w3 = ret_windows
        sma50 = aligned["adj_close"].rolling(50).mean()
        sma200 = aligned["adj_close"].rolling(200).mean()

        metrics_list.append(SectorMetrics(
            symbol=sym,
            sector=name,
            close=float(aligned["close"].iloc[-1]),
            rs_level=float(aligned["rs"].iloc[-1]),
            rs_slope=float(rs_slope),
            rs_slope_ann_pct=float(ann_pct),
            ret_1w=pct_change(aligned["adj_close"], w1),
            ret_1m=pct_change(aligned["adj_close"], w2),
            ret_3m=pct_change(aligned["adj_close"], w3),
            vol_z60=zscore_last(aligned["volume"], 60),
            sma50_above_sma200=bool(sma50.iloc[-1] > sma200.iloc[-1]) if len(aligned) >= 200 else None
        ))

    return metrics_list

def infer_rotation(metrics: List[SectorMetrics], top_k: int = 3) -> Dict:
    """Calculates inflow/outflow rankings and suggests rotation pairs."""
    df = pd.DataFrame([m.__dict__ for m in metrics])
    if df.empty:
        return {"inflows": [], "outflows": [], "pairs": []}

    inflows = df[(df["rs_slope"] > 0) & (df["ret_1m"] > 0)].nlargest(top_k, "rs_slope")
    outflows = df[(df["rs_slope"] < 0) & (df["ret_1m"] < 0)].nsmallest(top_k, "rs_slope")

    pairs = []
    for _, o in outflows.iterrows():
        for _, i in inflows.iterrows():
            spread = (i["rs_slope"] - o["rs_slope"]) + 0.5 * (i["ret_1m"] - o["ret_1m"])
            pairs.append({
                "from": f"{o['symbol']} ({o['sector']})",
                "to": f"{i['symbol']} ({i['sector']})",
                "score": round(spread, 6)
            })
    
    return {
        "inflows": inflows.to_dict(orient="records"),
        "outflows": outflows.to_dict(orient="records"),
        "pairs": sorted(pairs, key=lambda x: x["score"], reverse=True)[:top_k*2]
    }

# -----------------------------------------------------------------------------
# Output & Visualization
# -----------------------------------------------------------------------------

def plot_rrg(df: pd.DataFrame, title: str):
    """Visualizes RS Level vs RS Momentum in a quadrant chart."""
    
    plt.figure(figsize=(12, 7))
    x, y = df["rs_level"], df["rs_slope_ann_pct"] * 100
    
    plt.scatter(x, y, s=150, alpha=0.6, c=y, cmap="RdYlGn")
    for i, row in df.iterrows():
        plt.text(row["rs_level"], row["rs_slope_ann_pct"] * 100, row["symbol"], fontsize=10)

    plt.axvline(np.median(x), color="black", linestyle="--", alpha=0.3)
    plt.axhline(np.median(y), color="black", linestyle="--", alpha=0.3)
    
    plt.title(title, fontsize=14)
    plt.xlabel("RS Level (Ratio to Benchmark)")
    plt.ylabel("RS Momentum (Annualized %)")
    plt.grid(True, alpha=0.2)
    plt.savefig("sector_rotation_chart.png")
    print("[*] Chart saved to sector_rotation_chart.png")
    plt.show()

# -----------------------------------------------------------------------------
# Main Execution
# -----------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="Sector Rotation Screener")
    parser.add_argument("--period", default="2y", help="Data period (e.g. 1y, 2y, 5y)")
    parser.add_argument("--benchmark", default=DEFAULT_BENCH, help="Benchmark ticker")
    parser.add_argument("--custom_file", help="Path to custom sector CSV")
    parser.add_argument("--slope_window", type=int, default=30, help="RS slope window in days")
    parser.add_argument("--plot", action="store_true", help="Generate RRG plot")
    parser.add_argument("--json", action="store_true", help="Output results as JSON")
    args = parser.parse_args()

    mapping = load_custom_mapping(args.custom_file) if args.custom_file else DEFAULT_SECTORS
    tickers = list(set(list(mapping.keys()) + [args.benchmark]))
    
    panels = download_data(tickers, period=args.period)
    metrics = compute_sector_metrics(panels, mapping, args.benchmark, args.slope_window)
    
    df_results = pd.DataFrame([m.__dict__ for m in metrics]).sort_values("rs_slope", ascending=False)

    if df_results.empty:
        print("[-] No data found. Check your tickers and internet connection.")
        return

    print(f"\n=== Sector Rotation Report (Benchmark: {args.benchmark}) ===")
    print(df_results[["symbol", "sector", "rs_slope_ann_pct", "ret_1m", "vol_z60"]].to_string(index=False))

    rot = infer_rotation(metrics)
    print("\n[+] Top Suggested Rotations:")
    for p in rot["pairs"]:
        print(f"  {p['from']}  --->  {p['to']}  (Score: {p['score']})")

    if args.plot:
        plot_rrg(df_results, f"Sector Rotation: {args.benchmark} Benchmark")

if __name__ == "__main__":
    main()
